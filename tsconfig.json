{
  "compilerOptions": {
    "moduleResolution": "node",
    "lib": ["dom", "esnext"],
    "types": ["jest", "react", "react-dom", "@testing-library/jest-dom"],
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
